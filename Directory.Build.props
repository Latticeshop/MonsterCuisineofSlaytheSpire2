<Project>
    <PropertyGroup>
        <!-- Megadot current version is 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->
        <!-- MegaDot / Godot 4.5.1 mono executable used for export-pack when publishing -->

        <!-- 主要Godot路径（取消注释并使用你的实际路径） -->
        <GodotPath>D:/RedAlert2Project/Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>

        <!-- 使用共享 NuGet 缓存，避免把包恢复到项目内 -->
        <RestorePackagesPath>C:\Users\Latticeshop\.nuget\packages</RestorePackagesPath>
    </PropertyGroup>
</Project>
